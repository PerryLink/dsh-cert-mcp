{
  "name": "dsh-cert-mcp",
  "version": "0.2.3",
  "description": "Read-only MCP server exposing the dsh-plugin-certification registry: certification grades, snapshots and five-dimension evidence for DeepSeek Harness plugins.",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "bin": {
    "dsh-cert-mcp": "src/index.js"
  },
  "files": [
    "src",
    "data",
    "cordis.patch.yml",
    "server.json",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "certification",
    "supply-chain-security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-cert-mcp.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PerryLink"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node --test \"test/*.spec.mjs\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:ci": "tsc -p tsconfig.check.ci.json",
    "typecheck:checkout": "tsc -p tsconfig.checkout.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  },
  "mcpName": "io.github.PerryLink/dsh-cert",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
